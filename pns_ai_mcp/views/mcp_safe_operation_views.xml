<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista de "AI Requests" (Safe Plan / Caja B).
    Permite confirmar/cancelar desde Odoo las operaciones propuestas por la IA,
    útil para clientes de inferencia externos (Claude, Cursor...) que no tienen
    la UI de chatboo. La seguridad la dan los métodos del modelo (solo el dueño)
    y las reglas de registro (cada usuario ve solo las suyas).
-->
<odoo>
    <record id="view_mcp_safe_operation_search" model="ir.ui.view">
        <field name="name">ai.safe.operation.search</field>
        <field name="model">ai.safe.operation</field>
        <field name="arch" type="xml">
            <search string="Authorizations">
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Only mine" name="only_mine"
                        domain="[('user_id', '=', uid)]"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <field name="verification_id"/>
                <field name="request_ip"/>
            </search>
        </field>
    </record>

    <record id="view_mcp_safe_operation_tree" model="ir.ui.view">
        <field name="name">ai.safe.operation.tree</field>
        <field name="model">ai.safe.operation</field>
        <field name="arch" type="xml">
            <tree create="0" string="Authorizations"
                  class="o_pns_list"
                  decoration-warning="is_expired == True"
                  decoration-muted="status in ('cancelled', 'expired')">
                <field name="create_date" optional="show"/>
                <field name="verification_id" optional="show"/>
                <field name="danger_level" optional="show"/>
                <field name="operation_type" optional="show"/>
                <field name="model_name" optional="show"/>
                <field name="records_count" optional="show"/>
                <field name="fetch_url_display" optional="show" attrs="{'invisible': [('operation_type', '!=', 'fetch_url')]}"/>
                <field name="user_id" optional="show"/>
                <field name="status" optional="show"/>
                <field name="expires_at" optional="show"/>
                <field name="is_expired" optional="show"/>
                <field name="can_resolve" invisible="1"/>
                <field name="can_apply" invisible="1"/>
                <field name="can_add_whitelist" invisible="1"/>
                <field name="request_ip" optional="hide"/>
                <field name="executed" optional="show"/>
                <button name="action_confirm_and_execute" type="object" string="Confirm"
                        icon="fa-check"
                        attrs="{'invisible': ['!', '|', ('can_resolve', '=', True), ('can_apply', '=', True)]}"/>
                <button name="action_cancel" type="object" string="Cancel"
                        icon="fa-times" attrs="{'invisible': [('can_resolve', '=', False)]}"/>
                <button name="action_add_to_whitelist" type="object" string="➕ Whitelist"
                        icon="fa-globe" groups="pns_ai_mcp.group_ai_admin"
                        attrs="{'invisible': [('can_add_whitelist', '=', False)]}"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_safe_operation_form" model="ir.ui.view">
        <field name="name">ai.safe.operation.form</field>
        <field name="model">ai.safe.operation</field>
        <field name="arch" type="xml">
            <form create="0" string="AI Request">
                <header>
                    <button name="action_confirm_and_execute" type="object"
                            string="Confirm" class="btn-primary"
                            attrs="{'invisible': ['!', '|', ('can_resolve', '=', True), ('can_apply', '=', True)]}"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            attrs="{'invisible': [('can_resolve', '=', False)]}"/>
                    <button name="action_add_to_whitelist" type="object"
                            string="Add domain to whitelist"
                            groups="pns_ai_mcp.group_ai_admin"
                            attrs="{'invisible': [('can_add_whitelist', '=', False)]}"/>
                    <field name="status" widget="statusbar"/>
                    <field name="can_resolve" invisible="1"/>
                    <field name="can_apply" invisible="1"/>
                    <field name="can_add_whitelist" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="verification_id"/>
                            <field name="danger_level"/>
                            <field name="operation_type"/>
                            <field name="fetch_url_display" attrs="{'invisible': [('operation_type', '!=', 'fetch_url')]}"
                                   widget="url"/>
                            <field name="model_name"/>
                            <field name="records_count"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date"/>
                            <field name="expires_at"/>
                            <field name="is_expired"/>
                            <field name="confirmed_by_uid"/>
                            <field name="resolved_at"/>
                            <field name="request_ip"/>
                            <field name="executed"/>
                            <field name="valid_from" attrs="{'invisible': [('operation_type', '!=', 'fetch_url')]}"/>
                            <field name="valid_until" attrs="{'invisible': [('operation_type', '!=', 'fetch_url')]}"/>
                        </group>
                    </group>
                    <group string="Plan / proposed changes">
                        <field name="changes_info" nolabel="1"/>
                    </group>
                    <group string="Execution result"
                           attrs="{'invisible': [('result_info', '=', False)]}">
                        <field name="result_info" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_safe_operation" model="ir.actions.act_window">
        <field name="name">My Authorizations</field>
        <field name="res_model">ai.safe.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">There are no pending operations</p>
            <p>Here you will find the operations proposed by the AI that require your confirmation.</p>
        </field>
    </record>

    <menuitem id="menu_mcp_safe_operation"
              name="My Authorizations"
              parent="pns_ai_mcp.menu_ai_security"
              action="action_mcp_safe_operation"
              sequence="20"
              groups="pns_ai_mcp.group_ai_writer,pns_ai_mcp.group_ai_external_url,pns_ai_mcp.group_ai_external_api"/>

    <record id="action_mcp_safe_operation_admin" model="ir.actions.act_window">
        <field name="name">Authorizations</field>
        <field name="res_model">ai.safe.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mcp_safe_operation_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">There are no pending operations</p>
            <p>Supervised operations proposed by the AI that require user confirmation.</p>
        </field>
    </record>

    <menuitem id="menu_mcp_safe_operation_admin"
              name="Authorizations"
              parent="pns_ai_mcp.menu_ai_security"
              action="action_mcp_safe_operation_admin"
              sequence="10"
              groups="pns_ai_mcp.group_ai_admin"/>
</odoo>
