    <!-- Export Selected — keep binding -->
    <record id="action_server_export_selected_skills" model="ir.actions.server">
        <field name="name">Export selected skills to ZIP</field>
        <field name="model_id" ref="model_ai_skill"/>
        <field name="binding_model_id" ref="model_ai_skill"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_selected()</field>
    </record>

</odoo>
