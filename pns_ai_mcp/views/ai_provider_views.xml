<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <header>
                    <button name="test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Provider Name e.g. Anthropic Cloud, Local LLM"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active"/>
                        <field name="alias" placeholder="e.g. Grok 4.5 (normal use) — shown in Chatboo picker"/>
                    </group>
                    <group string="Connection" name="connection">
                        <field name="protocol"/>
                        <field name="endpoint_setup_guide" nolabel="1" colspan="2" readonly="1"/>
                        <field name="endpoint" placeholder="https://&lt;host&gt;:&lt;port&gt;/… (see template above)"/>
                        <field name="api_key" password="True" placeholder="Provider API key"/>
                    </group>
                    <group string="Model" name="model">
                        <label for="model_id" string="Model"/>
                        <div class="o_row">
                            <field name="model_id" placeholder="Select a model..." options="{'no_create': True}"/>
                            <button name="action_copy_model_catalogue" string="Copy catalogue" type="object" class="btn-link" icon="fa-clipboard"/>
                            <button name="action_pick_model" string="Browse" type="object" class="btn-link" icon="fa-list"/>
                        </div>
                        <field name="model_name" attrs="{'invisible': [('model_id', '!=', False)]}"/>
                        <label for="context_window"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <div class="o_row" attrs="{'invisible': [('protocol', '=', 'systemone')]}">
                            <field name="context_window" widget="context_window_combo" nolabel="1"/>
                            <field name="context_window_tokens" nolabel="1" readonly="1" class="text-muted"/>
                        </div>
                        <field name="temperature" widget="float"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <field name="temperature_support"
                               attrs="{'invisible': [('protocol', '!=', 'anthropic')]}"/>
                    </group>
                    <group string="Capabilities" name="capabilities">
                        <field name="fit_conversation"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <field name="fit_audio"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <field name="fit_vision"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <field name="fit_video"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <field name="fit_decision"/>
                        <field name="decision_min_confidence"
                               attrs="{'invisible': [('fit_decision', '=', False)]}"/>
                        <field name="usage_support"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                        <field name="stt_support"
                               attrs="{'invisible': [('protocol', '=', 'systemone')]}"/>
                    </group>
                    <group name="chain">
                        <field name="no_external_failover"/>
                    </group>
                    <group string="Presentation" name="presentation"
                           attrs="{'invisible': [('protocol', '=', 'systemone')]}">
                        <field name="compose"/>
                        <field name="footmode"
                               attrs="{'invisible': [('protocol', '=', 'anthropic')]}"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_ai_provider_tree" model="ir.ui.view">
        <field name="name">ai.provider.tree</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <tree string="Providers" class="o_pns_list o_pns_provider_list">
                <field name="name" optional="show"/>
                <field name="active" optional="show"/>
                <field name="fit_chips_html" string="Fits" widget="pns_html_readonly" readonly="1" optional="show"/>
                <field name="alias" optional="show"/>
                <field name="protocol" optional="show"/>
                <field name="model_name" optional="show"/>
                <field name="context_window_display" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ai_provider_search" model="ir.ui.view">
        <field name="name">ai.provider.search</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <search string="Providers">
                <field name="name"/>
                <field name="alias"/>
                <field name="model_name"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Protocol" name="group_by_protocol" context="{'group_by': 'protocol'}"/>
            </search>
        </field>
    </record>

    <!-- Context Action -->
    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new AI Provider
            </p>
        </field>
    </record>

    <record id="view_ai_provider_model_tree" model="ir.ui.view">
        <field name="name">ai.provider.model.tree</field>
        <field name="model">ai.provider.model</field>
        <field name="arch" type="xml">
            <tree string="Models" create="false" edit="false" delete="false" class="o_pns_model_picker">
                <button name="action_select_for_provider" type="object" string="Use" icon="fa-check"/>
                <field name="maker"/>
                <field name="title"/>
                <field name="name"/>
                <field name="context_label"/>
                <field name="max_output_label"/>
                <field name="price_in_label"/>
                <field name="price_out_label"/>
                <field name="price_cache_label"/>
                <field name="modality_label"/>
                <field name="apt_audio"/>
                <field name="apt_transcriptions"/>
                <field name="apt_label"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_provider_model_search" model="ir.ui.view">
        <field name="name">ai.provider.model.search</field>
        <field name="model">ai.provider.model</field>
        <field name="arch" type="xml">
            <search string="Models">
                <field name="maker"/>
                <field name="title"/>
                <field name="name"/>
                <filter string="Conversation" name="apt_conversation" domain="[('apt_conversation', '=', True)]"/>
                <filter string="Reasoning" name="apt_reasoning" domain="[('apt_reasoning', '=', True)]"/>
                <filter string="Batch" name="apt_batch" domain="[('apt_batch', '=', True)]"/>
                <filter string="Vision" name="apt_vision" domain="[('apt_vision', '=', True)]"/>
                <filter string="Audio" name="apt_audio" domain="[('apt_audio', '=', True)]"/>
                <filter string="Whisper" name="apt_transcriptions" domain="[('apt_transcriptions', '=', True)]"/>
                <filter string="File" name="apt_file" domain="[('apt_file', '=', True)]"/>
                <filter string="Decision" name="apt_decision" domain="[('apt_decision', '=', True)]"/>
                <separator/>
                <filter string="Maker" name="group_maker" context="{'group_by': 'maker'}"/>
            </search>
        </field>
    </record>
</odoo>
