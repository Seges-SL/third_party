<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Purga el registro de IA más antiguo que pns_ai_mcp.log_retention_days
         (sin fijar o 0 = no se borra nada; los dias se fijan en Ajustes). Stack owl1 (Odoo 14): numbercall=-1. -->
    <record id="ir_cron_ai_log_retention" model="ir.cron">
        <field name="name">AI: purge activity log older than retention</field>
        <field name="model_id" ref="model_ai_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
