<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Vacía la papelera del diario más antigua que pns_ai_mcp.journal_trash_days
         (por defecto 30; 0 = no se vacía sola). Stack owl1 (Odoo 14): numbercall=-1. -->
    <record id="ir_cron_ai_journal_trash" model="ir.cron">
        <field name="name">AI: empty change trash older than retention</field>
        <field name="model_id" ref="model_ai_change_journal"/>
        <field name="state">code</field>
        <field name="code">model._cron_empty_journal_trash()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
