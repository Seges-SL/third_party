<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Generic system trusted actions. Extra group = AI Administrator
         (Writer is already the floor of any op=action). Args are closed:
         model/field/views, module+operation, user+group — no domain literals. -->

    <record id="trusted_action_field_set_required" model="ai.trusted.action">
        <field name="code">field.set_required</field>
        <field name="label">Set field required on the model</field>
        <field name="danger">medium</field>
        <field name="model_id" ref="model_ai_system_action"/>
        <field name="preview_method">preview_field_set_required</field>
        <field name="apply_method">apply_field_set_required</field>
        <field name="group_ids" eval="[(4, ref('group_ai_admin'))]"/>
    </record>

    <record id="trusted_action_view_set_field_required" model="ai.trusted.action">
        <field name="code">view.set_field_required</field>
        <field name="label">Set field required on views</field>
        <field name="danger">medium</field>
        <field name="model_id" ref="model_ai_system_action"/>
        <field name="preview_method">preview_view_set_field_required</field>
        <field name="apply_method">apply_view_set_field_required</field>
        <field name="group_ids" eval="[(4, ref('group_ai_admin'))]"/>
    </record>

