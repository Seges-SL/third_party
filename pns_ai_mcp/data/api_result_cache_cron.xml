<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Purga entradas caducadas de la caché efímera de api_call (Safe Plan).
         Stack owl1 (Odoo 14): mantiene numbercall/doall si el stack lo requiere. -->
    <record id="ir_cron_ai_api_result_cache_gc" model="ir.cron">
        <field name="name">AI: purge expired api_call result cache</field>
        <field name="model_id" ref="model_ai_api_result_cache"/>
        <field name="state">code</field>
        <field name="code">model.gc_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
