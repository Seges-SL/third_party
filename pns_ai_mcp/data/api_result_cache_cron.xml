<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Purges expired entries from the short-lived api_call cache (Safe Plan).
         Stack owl1 (Odoo 14): without numbercall=-1 the cron turns off after
         the first run (the default is 1). -->
    <record id="ir_cron_ai_api_result_cache_gc" model="ir.cron">
        <field name="name">AI: purge expired api_call result cache</field>
        <field name="model_id" ref="model_ai_api_result_cache"/>
        <field name="state">code</field>
        <field name="code">model._gc_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
