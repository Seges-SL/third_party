<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Expires overdue pending rows: without this the Authorizations queue piles up zombies
         (status=pending + is_expired) and the confirmation toast becomes unusable.
         Stack owl1 (Odoo 13/14): numbercall/doall. -->
    <record id="ir_cron_ai_safe_operation_expire" model="ir.cron">
        <field name="name">AI: expire pending supervised operations</field>
        <field name="model_id" ref="model_ai_safe_operation"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_expired()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
    <!-- There is NO «execute confirmed» cron: it hijacked workers (forever-busy)
         and competed with the toast. Confirm and execute are two separate HTTP calls;
         the apply is fired by the host (/verification/execute) or Authorizations.
         The legacy record is switched off in migration 3.0.146. -->
</odoo>
