<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Purge expired entries of the immutable fetch_url cache.
         Reads already skip expired entries; this only keeps the table from growing.
         Stack owl1 (Odoo 13/14): uses numbercall/doall (they exist in this version). -->
    <record id="ir_cron_ai_fetch_cache_gc" model="ir.cron">
        <field name="name">AI: purge expired fetch_url cache</field>
        <field name="model_id" ref="model_ai_fetch_cache"/>
        <field name="state">code</field>
        <field name="code">model._gc_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
