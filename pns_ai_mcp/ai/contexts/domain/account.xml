<?xml version="1.0" encoding="UTF-8"?>
<context>
    <metadata>
        <code>account</code>
        <tipo>domain</tipo>
        <description>Odoo Accounting module knowledge - invoices, refunds, payments</description>
        <created_at>2025-01-25</created_at>
        <created_by>Administrator</created_by>
        <modified_at>2025-01-25</modified_at>
        <modified_by>Administrator</modified_by>
    </metadata>
    
    <domain_knowledge>
        <module name="accounting" model="account.move">
            <description>Invoices, Refunds, and Payments.</description>
            <version_matrix>
                <v14_plus>
                    <model>account.move</model>
                    <type_field>move_type</type_field>
                    <amount_field>amount_untaxed_signed</amount_field>
                    <types>out_invoice, in_invoice, out_refund, in_refund</types>
                </v14_plus>
                <v13_minus>
                    <model>account.invoice</model>
                    <type_field>type</type_field>
                    <amount_field>amount_untaxed</amount_field>
                    <note>Manually subtract refunds.</note>
                </v13_minus>
            </version_matrix>
            <patterns>
            </patterns>
            <conventions>
                <convention name="purchase_coloring">
                    When displaying purchase aggregations by supplier (in_invoice/in_refund grouped by partner),
                    apply the 3-tier color convention by default to the total/volume column, even if not explicitly requested.
                    move_type='in_invoice' for purchases, 'in_refund' for purchase refunds.
                </convention>
            </conventions>
        </module>
    </domain_knowledge>
</context>
