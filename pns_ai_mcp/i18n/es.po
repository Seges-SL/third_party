#. module: pns_ai_mcp
#: model:ir.model.fields,help:pns_ai_mcp.field_ai_provider__fit_decision
msgid "Answers a closed Choice (yes or none, with a confidence). The decision agent chain only takes providers with this tick. The protocol must be able to choose."
msgstr "Responde un Choice cerrado (sí o ninguno, con una confianza). La cadena del agente de decisión solo admite proveedores con esta marca. El protocolo tiene que saber elegir."

#. module: pns_ai_mcp
#: code:addons/pns_ai_mcp/models/ai_provider.py:0
msgid "Protocol %s cannot answer a closed choice. Clear the Decision tick."
msgstr "El protocolo %s no responde un Choice cerrado. Quita la marca Decisión."

#. module: pns_ai_mcp
#: code:addons/pns_ai_mcp/models/ai_provider.py:0
msgid "Protocol %s only answers a closed choice. Tick Decision and nothing else."
msgstr "El protocolo %s solo responde un Choice cerrado. Marca Decisión y nada más."

#. module: pns_ai_mcp
