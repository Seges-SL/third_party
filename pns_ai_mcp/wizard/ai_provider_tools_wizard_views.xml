<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_tools_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.provider.tools.wizard.form</field>
        <field name="model">pns_ai_mcp.provider.tools.wizard</field>
        <field name="arch" type="xml">
            <form string="Providers Tools">
                <div class="alert alert-info mb-0" role="alert">
                    <p>Select the operation to perform:</p>
                    <ul class="mb-0">
                        <li>Export JSON: Download a file with all current providers.</li>
                        <li>Import JSON: Open the wizard to upload a previously exported file.</li>
                    </ul>
                </div>
                <footer>
                    <button name="action_export" string="Export JSON" type="object" class="btn-primary" icon="fa-download"/>
                    <button name="action_import" string="Import JSON" type="object" class="btn-secondary" icon="fa-upload"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_provider_tools_wizard" model="ir.actions.act_window">
        <field name="name">Providers Tools</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pns_ai_mcp.provider.tools.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ai_provider_tools_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
