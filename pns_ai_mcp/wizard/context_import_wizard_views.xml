<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_context_import_wizard_form" model="ir.ui.view">
        <field name="name">pns.ai.mcp.context.import.wizard.form</field>
        <field name="model">pns_ai_mcp.context_import_wizard</field>
        <field name="arch" type="xml">
            <form string="Import Contexts">
                <field name="import_mode" invisible="1"/>
                <group>
                    <field name="import_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                </group>
                <div class="alert alert-info" role="alert"
                     attrs="{'invisible': [('import_mode', '!=', False)]}">
                    Upload a .txt, .md, .xml or .zip file with contexts.<br/>
                    If "Replace existing" is checked, contexts with the same code and path will be updated.
                </div>
                <div class="alert alert-info" role="alert"
                     attrs="{'invisible': [('import_mode', '!=', 'zip')]}">
                    Upload a contexts export ZIP (manifest.json + context files). Existing ones (same code and path) are skipped unless "Replace existing" is checked. Protocol contexts are never overwritten.
                </div>
                <div class="alert alert-info" role="alert"
                     attrs="{'invisible': [('import_mode', '!=', 'zip_selected')]}">
                    Upload a ZIP from "Export selected contexts to ZIP" (manifest scope sel-*). Only contexts listed in the manifest are imported. Protocol contexts are never overwritten.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_context_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Contexts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pns_ai_mcp.context_import_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
