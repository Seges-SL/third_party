<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_agents_wizard_form" model="ir.ui.view">
        <field name="name">pns.ai.mcp.import.agents.wizard.form</field>
        <field name="model">pns_ai_mcp.import_agents_wizard</field>
        <field name="arch" type="xml">
            <form string="Import AI Agents">
                <sheet>
                    <div class="alert alert-info" role="alert" >
                        <p>Upload a previously exported JSON file.</p>
                        <p>If "Replace existing" is checked, agents with the same code will be updated (including their provider chain).</p>
                    </div>
                    <group >
                        <field name="json_file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="replace_existing"/>
                    </group>
</sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
</footer>
            </form>
        </field>
    </record>

    <record id="action_import_agents_wizard" model="ir.actions.act_window">
        <field name="name">Import AI Agents (JSON)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pns_ai_mcp.import_agents_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
