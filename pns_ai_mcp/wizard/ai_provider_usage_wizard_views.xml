<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_usage_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.provider.usage.wizard.form</field>
        <field name="model">ai.provider.usage.wizard</field>
        <field name="arch" type="xml">
            <form string="This month">
                <group>
                    <field name="provider_id"/>
                    <field name="period_label"/>
                </group>
                <group string="Usage">
                    <field name="prompt_tokens"/>
                    <field name="completion_tokens"/>
                    <field name="total_tokens"/>
                    <field name="cost_display"/>
                </group>
                <group string="Cap">
                    <field name="cap_label"/>
                    <field name="remaining_label"/>
                </group>
                <footer>
                    <button name="action_open_log" string="Open history" type="object" class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
