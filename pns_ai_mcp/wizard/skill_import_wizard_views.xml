<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_skill_import_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.skill.import.wizard.form</field>
        <field name="model">pns_ai_mcp.skill.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group >
                    <div class="oe_title"><h1>Import skills from ZIP</h1></div>
                    <field name="import_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                </group>
                <div class="alert alert-info" role="alert" >
                    Upload a skills export ZIP (manifest.json + skills/*.md). New skills are created; existing ones (same code) are skipped unless "Replace existing" is checked. Referenced contexts are linked only if they already exist.
                </div>
<footer>
                    <button name="action_import" string="Import" type="object"
                            class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
</footer>
            </form>
        </field>
    </record>
</odoo>
