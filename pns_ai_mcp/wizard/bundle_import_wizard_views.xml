<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_context_agent_import_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.agent.import.wizard.form</field>
        <field name="model">pns_ai_mcp.agent.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="agent_id" invisible="1"/>
                <group >
                    <div class="oe_title"><h1>Import bundle from ZIP</h1></div>
                    <field name="import_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                    <field name="replace_composition"/>
                </group>
                <div class="alert alert-info" role="alert" >
                    Upload a bundle export ZIP (manifest.json + context files).
                    New contexts are created; existing ones (same code and path) are
                    skipped unless "Replace existing" is checked. Protocol contexts
                    are never overwritten. Composition is taken from manifest.json
                    when "Replace composition" is checked.
                </div>
<footer>
                    <button name="action_import" string="Import" type="object"
                            class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
</footer>
            </form>
        </field>
    </record>
</odoo>
