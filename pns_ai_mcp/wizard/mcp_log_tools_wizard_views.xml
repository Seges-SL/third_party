<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_log_tools_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.log.tools.wizard.form</field>
        <field name="model">pns_ai_mcp.log.tools.wizard</field>
        <field name="arch" type="xml">
            <form string="History Tools">
                <div class="alert alert-info mb-0" role="alert">
                    <p>Select the operation to perform:</p>
                    <ul class="mb-0">
                        <li>Export JSON: Download a file with all history entries.</li>
                        <li>Clear History: Delete old history entries, keeping the most recent ones.</li>
                    </ul>
                </div>
                <footer>
                    <button name="action_export" string="Export JSON" type="object" class="btn-primary" icon="fa-download"/>
                    <button name="action_clear" string="Clear History" type="object" class="btn-danger" icon="fa-trash"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_log_tools_wizard" model="ir.actions.act_window">
        <field name="name">History Tools</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pns_ai_mcp.log.tools.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mcp_log_tools_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
