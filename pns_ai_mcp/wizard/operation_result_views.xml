                    <field name="result_errors" attrs="{'invisible': [('result_errors', '=', False)]}"/>
                    <field name="result_detail" string="Removed from agent"
                           attrs="{'invisible': [('result_detail', '=', False)]}"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- pns_ai_mcp.config_backup_wizard — full AI configuration restore -->
    <record id="view_config_backup_result_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.config_backup.wizard.result</field>
        <field name="model">pns_ai_mcp.config_backup_wizard</field>
        <field name="arch" type="xml">
            <form string="Configuration import result">
                <field name="show_result" invisible="1"/>
                <field name="result_status" invisible="1"/>
                <group name="result_alerts">
                    <div class="alert alert-success mb-0" role="alert"
                         attrs="{'invisible': [('result_status', '!=', 'success')]}">
                        <i class="fa fa-check-circle" title="Success" role="img" aria-hidden="true"/> <strong>Configuration restored successfully.</strong>
                    </div>
                    <div class="alert alert-warning mb-0" role="alert"
                         attrs="{'invisible': [('result_status', '!=', 'warning')]}">
                        <i class="fa fa-exclamation-triangle" title="Warning" role="img" aria-hidden="true"/> <strong>Configuration restored with warnings.</strong>
                    </div>
                    <div class="alert alert-danger mb-0" role="alert"
                         attrs="{'invisible': [('result_status', '!=', 'danger')]}">
                        <i class="fa fa-times-circle" title="Error" role="img" aria-hidden="true"/> <strong>Configuration import failed.</strong>
                    </div>
                </group>
                <group name="result_counts">
                    <field name="result_created" string="Created"/>
                    <field name="result_updated" string="Updated"/>
                    <field name="result_skipped" string="Skipped (already existed)"
                           attrs="{'invisible': [('result_skipped', '=', 0)]}"/>
                </group>
                <group name="result_messages">
                    <field name="result_detail" string="Breakdown by section"
                           attrs="{'invisible': [('result_detail', '=', False)]}"/>
                    <field name="result_warnings" attrs="{'invisible': [('result_warnings', '=', False)]}"/>
                    <field name="result_errors" attrs="{'invisible': [('result_errors', '=', False)]}"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- pns_ai_mcp.artifact_bundle.import.wizard -->
    <record id="view_artifact_bundle_import_result_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.artifact.bundle.import.wizard.result</field>
        <field name="model">pns_ai_mcp.artifact_bundle.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import result">
                <field name="show_result" invisible="1"/>
                <field name="result_status" invisible="1"/>
                <group name="result_alerts">
                    <div class="alert alert-success mb-0" role="alert"
                         attrs="{'invisible': [('result_status', '!=', 'success')]}">
                        <i class="fa fa-check-circle" title="Success" role="img" aria-hidden="true"/> <strong>Import completed successfully.</strong>
                    </div>
                    <div class="alert alert-warning mb-0" role="alert"
                         attrs="{'invisible': [('result_status', '!=', 'warning')]}">
                        <i class="fa fa-exclamation-triangle" title="Warning" role="img" aria-hidden="true"/> <strong>Import completed with warnings.</strong>
                    </div>
                    <div class="alert alert-danger mb-0" role="alert"
                         attrs="{'invisible': [('result_status', '!=', 'danger')]}">
                        <i class="fa fa-times-circle" title="Error" role="img" aria-hidden="true"/> <strong>Import failed.</strong>
                    </div>
                </group>
                <group name="result_counts">
                    <field name="result_created" string="Created"/>
                    <field name="result_updated" string="Updated"/>
                    <field name="result_skipped" string="Skipped (existing, not replaced)"
                           attrs="{'invisible': [('result_skipped', '=', 0)]}"/>
                </group>
                <group name="result_messages">
                    <field name="result_warnings" attrs="{'invisible': [('result_warnings', '=', False)]}"/>
                    <field name="result_errors" attrs="{'invisible': [('result_errors', '=', False)]}"/>
                    <field name="result_detail" attrs="{'invisible': [('result_detail', '=', False)]}"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

