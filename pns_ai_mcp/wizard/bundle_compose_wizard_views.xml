<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_context_agent_compose_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.agent.compose.wizard.form</field>
        <field name="model">pns_ai_mcp.agent.compose.wizard</field>
        <field name="arch" type="xml">
            <form string="Compose Agent Contexts">
                <group>
                    <field name="agent_id" readonly="1"/>
                </group>
                <p>One row per logical context (locale variants resolve automatically at build time).</p>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="selected" optional="show"/>
                        <field name="in_composition" readonly="1" optional="show"/>
                        <field name="code" readonly="1" optional="show"/>
                        <field name="context_type" readonly="1" optional="show"/>
                        <field name="description" readonly="1" optional="hide"/>
                        <field name="context_id" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_add_to_agent" string="Add to agent" type="object" class="btn-primary"/>
                    <button name="action_remove_from_agent" string="Remove from agent" type="object" class="btn-secondary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
