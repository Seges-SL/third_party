<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_artifact_bundle_export_wizard_form" model="ir.ui.view">
        <field name="name">pns.ai.mcp.artifact.bundle.export.wizard.form</field>
        <field name="model">pns_ai_mcp.artifact_bundle.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export artifact bundle">
                <group string="Content">
                    <field name="skill_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="context_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="provider_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="agent_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="server_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="user_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="whitelist_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <group string="Options">
                    <field name="include_secrets"/>
                    <field name="include_settings"/>
                    <field name="export_tag" placeholder="piloto"/>
                    <field name="export_artifact_name" placeholder="ai_artifact_bundle"/>
                </group>
                <footer>
                    <button name="action_export" string="Export bundle" type="object"
                            class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_artifact_bundle_export_wizard" model="ir.actions.act_window">
        <field name="name">Export artifact bundle</field>
        <field name="res_model">pns_ai_mcp.artifact_bundle.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_artifact_bundle_import_wizard_form" model="ir.ui.view">
        <field name="name">pns.ai.mcp.artifact.bundle.import.wizard.form</field>
        <field name="model">pns_ai_mcp.artifact_bundle.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import artifact bundle">
                <group>
                    <field name="import_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                </group>
                <footer>
                    <button name="action_import" string="Import bundle" type="object"
                            class="btn-primary" icon="fa-upload"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_artifact_bundle_import_wizard" model="ir.actions.act_window">
        <field name="name">Import artifact bundle</field>
        <field name="res_model">pns_ai_mcp.artifact_bundle.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
