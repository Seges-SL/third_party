<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_context_import_wizard_form" model="ir.ui.view">
        <field name="name">pns_ai_mcp.agent.context.import.wizard.form</field>
        <field name="model">pns_ai_mcp.agent.context.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="agent_id" invisible="1"/>
                <group >
                    <div class="oe_title"><h1>Import agent contexts from ZIP</h1></div>
                    <field name="import_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="replace_existing"/>
                </group>
                <div class="alert alert-info mb-0" role="alert" >
                    <p>Upload an agent contexts export ZIP (manifest.json + context files).</p>
                    <p>Contexts are assigned to this agent. Existing ones (same code and path) are skipped unless "Replace existing" is checked. Protocol contexts are never overwritten.</p>
                </div>
<footer>
                    <button name="action_import" string="Import" type="object"
                            class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
</footer>
            </form>
        </field>
    </record>
</odoo>
