<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block id="emails" position="inside">
                    <setting id="models_exclude_notify" string="Models to exclude from notification"
                             help="Select models for which you do not want to send 'You have been assigned'
                                notifications to the followers.
                                Company Related: configure this setting for each company separately.">
                        <field name="exaly_no_notify_models" widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"/>
                    </setting>
                </block>
            </field>
        </record>
    </data>
</odoo>