<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Borra los ficheros exportados más antiguos que
         pns_base.export_retention_hours (24 por defecto; 0 = no borrar).
         Stack owl1 (Odoo 14): numbercall=-1, and activity_user_type is
         NOT NULL on ir.act_server once mail is in. -->
    <record id="ir_cron_pns_export_purge" model="ir.cron">
        <field name="name">PNS: delete old export files</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="activity_user_type">specific</field>
        <field name="code">model._cron_purge_pns_exports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
