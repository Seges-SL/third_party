<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_secrets_wizard_form" model="ir.ui.view">
        <field name="name">pns.export.secrets.wizard.form</field>
        <field name="model">pns.export.secrets.wizard</field>
        <field name="arch" type="xml">
            <form string="Export">
                <group>
                    <field name="include_secrets"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     attrs="{'invisible': [('include_secrets', '=', False)]}">
                    The file will carry API keys and tokens in clear text. Keep it safe.
                </div>
                <div class="text-muted"
                     attrs="{'invisible': [('include_secrets', '=', True)]}">
                    Keys and tokens stay out of the file. Importing it never blanks the ones already set.
                </div>
                <footer>
                    <button name="action_export" type="object" string="Export"
                            class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
