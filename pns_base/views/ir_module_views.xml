<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_module_form_pns_index" model="ir.ui.view">
        <field name="name">ir.module.module.form.pns.index</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_html']" position="attributes">
                <attribute name="attrs">{'invisible': [('pns_index_url', '!=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='description_html']" position="after">
                <field name="pns_index_url" nolabel="1" colspan="4"
                       widget="pns_module_index"
                       attrs="{'invisible': [('pns_index_url', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
