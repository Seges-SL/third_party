<?xml version="1.0" encoding="utf-8"?>
<!-- Re-seed this addon's skills on every install/-u. Scoped: do not scan
     neighbor packs (Occ disk identity must not be overwritten). Apply path
     is the module update, not a confirmation toast.
     Files gone from this pack drop their factory rows in import_from_module
     (unlink_retired_from_module). No named kill list: a new install never
     had those rows, and a name someone plants later is not a leftover. -->
<odoo>
    <data noupdate="0">
        <function model="ai.skill" name="import_from_module"
                  eval="['pns_ai_chatboo']"/>
    </data>
</odoo>
