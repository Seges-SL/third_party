<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Chatboo: product settings + Agent Protocol shortcut. -->
    <record id="res_config_settings_view_form_chatboo_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.chatboo.mcp.agents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pns_ai_mcp.res_config_settings_view_form_mcp"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='mcp_internal_agents']" position="inside">
                <setting id="mcp_agent_chatboo" string="Chatboo"
                         help="Conversational client (pns_ai_chatboo · inference · code pns_ai_chatboo). Product preferences below; use Configuration for providers, contexts and skills.">
                    <div class="content-group">
                        <h3 class="text-muted mt8 mb8 h5">Interface</h3>
                        <div class="row">
                            <label for="chatboo_show_systray" class="col-lg-3 o_light_label"/>
                            <field name="chatboo_show_systray" class="col-lg-9"/>
                        </div>
                        <h3 class="text-muted mt16 mb8 h5">Conversation memory</h3>
                        <div class="row">
                            <label for="chatboo_dataset_cache_max_mb" class="col-lg-3 o_light_label"/>
                            <field name="chatboo_dataset_cache_max_mb" class="col-lg-9"/>
                        </div>
                        <div class="row mt8">
                            <label for="chatboo_query_data_ttl_hours" class="col-lg-3 o_light_label"/>
                            <field name="chatboo_query_data_ttl_hours" class="col-lg-9"/>
                        </div>
                        <h3 class="text-muted mt16 mb8 h5">Data presentation</h3>
                        <div class="row">
                            <label for="chatboo_chart_engine" class="col-lg-3 o_light_label"/>
                            <field name="chatboo_chart_engine" class="col-lg-9"/>
                        </div>
                        <div class="row mt8">
                            <label for="chatboo_default_show_mode" class="col-lg-3 o_light_label"/>
                            <field name="chatboo_default_show_mode" class="col-lg-9"/>
                        </div>
                        <h3 class="text-muted mt16 mb8 h5">Agent Protocol</h3>
                        <div>
                            <button name="action_open_module_agent" type="object"
                                    string="Configuration" class="btn-link" icon="fa-external-link"
                                    context="{'agent_code': 'pns_ai_chatboo'}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
