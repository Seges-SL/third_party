<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pages shared from a canvas. People are picked on the page itself;
         this list is where they are looked over, unshared or deleted.
         Each user sees their own; the AI admin sees every page. -->
    <record id="chatboo_canvas_page_view_tree" model="ir.ui.view">
        <field name="name">chatboo.canvas.page.tree</field>
        <field name="model">chatboo.canvas.page</field>
        <field name="arch" type="xml">
            <tree string="Shared pages" create="0">
                <field name="create_date" string="Shared on"/>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <button name="action_open_page" type="object"
                        string="Open page" icon="fa-external-link"/>
                <button name="action_unshare" type="object"
                        string="Stop sharing" icon="fa-user-times"/>
            </tree>
        </field>
    </record>

    <record id="chatboo_canvas_page_view_form" model="ir.ui.view">
        <field name="name">chatboo.canvas.page.form</field>
        <field name="model">chatboo.canvas.page</field>
        <field name="arch" type="xml">
            <form string="Shared page" create="0">
                <header>
                    <button name="action_open_page" type="object"
                            string="Open page" class="btn-primary"/>
                    <button name="action_unshare" type="object"
                            string="Stop sharing"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="url" widget="CopyClipboardChar"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="owner_id" readonly="1"/>
                        <field name="create_date" string="Shared on" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="chatboo_canvas_page_view_search" model="ir.ui.view">
        <field name="name">chatboo.canvas.page.search</field>
        <field name="model">chatboo.canvas.page</field>
        <field name="arch" type="xml">
            <search string="Shared pages">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="user_ids"/>
                <filter name="mine" string="Shared by me"
                        domain="[('owner_id', '=', uid)]"/>
                <filter name="to_me" string="Shared with me"
                        domain="[('user_ids', 'in', [uid])]"/>
                <separator/>
                <filter name="group_owner" string="Owner"
                        context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_chatboo_canvas_page" model="ir.actions.act_window">
        <field name="name">Shared pages</field>
        <field name="res_model">chatboo.canvas.page</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="chatboo_canvas_page_view_search"/>
    </record>

    <menuitem id="menu_chatboo_shared_pages"
              name="Shared pages"
              parent="pns_ai_mcp.menu_ai_security"
              action="action_chatboo_canvas_page"
              sequence="60"/>
</odoo>
