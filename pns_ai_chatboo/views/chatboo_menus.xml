<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción principal de chat (componente OWL2 'chatboo.action'). -->
    <record id="action_chatboo_client" model="ir.actions.client">
        <field name="name">Chatboo Assistant</field>
        <field name="tag">chatboo.action</field>
        <field name="target">current</field>
    </record>

    <!-- App raíz, hermana de MCP Server. -->
    <menuitem id="menu_chatboo_root"
              name="Chatboo"
              sequence="11"
              web_icon="pns_ai_chatboo,static/description/icon.png"
              action="action_chatboo_client"/>
</odoo>
